LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# MongoDB Atlas connection string (M0 free tier supported)
MONGODB_URI=

# Optional: override the default database name (livekit_mongo_starter)
MONGODB_DB=

# Voyage AI API key for text embeddings
# Free tier: https://www.voyageai.com/pricing
VOYAGE_API_KEY=

# Optional clinic settings (defaults: Sunrise Clinic, America/New_York).
# Doctor working hours in the `doctors` collection use this time zone.
CLINIC_NAME=
CLINIC_TIMEZONE=
